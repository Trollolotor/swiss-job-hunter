[Unit]
Description=Swiss Job Hunter restricted connector launcher
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=root
Group=sjh-connector
RuntimeDirectory=sjh-connector
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/python3 /usr/local/lib/sjh-connector/connector-launcher.py
ExecStopPost=/usr/bin/python3 /usr/local/lib/sjh-connector/connector-launcher.py --cleanup
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/sjh-connector
RestrictAddressFamilies=AF_UNIX
MemoryMax=256M
TasksMax=64
UMask=0007

[Install]
WantedBy=multi-user.target
